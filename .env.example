# انسخ هالملف باسم .env.local (على جهازك) — وعلى Vercel حطها بـ Settings → Environment Variables.
# الرابط من MongoDB Atlas → Connect → Drivers (حط اسم قاعدة البيانات aqsati بعد .net/)
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/aqsati?retryWrites=true&w=majority
# اختياري (الافتراضي aqsati)
MONGODB_DB=aqsati
# اختياري — للتجربة على جهازك بس: 1 = قاعدة بيانات بالذاكرة بدل MongoDB (كل شي ينمسح لما يوقف السيرفر).
# نفس `node server.mjs --memory`. لا تحطه على Vercel.
# AQSATI_MEMORY_DB=1
