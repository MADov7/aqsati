modules = ["nodejs-22"]
run = "npm install --omit=dev --no-audit --no-fund && node server.mjs"
entrypoint = "server.mjs"

[env]
PORT = "3000"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
run = ["node", "server.mjs"]
build = ["npm", "install", "--omit=dev", "--no-audit", "--no-fund"]
deploymentTarget = "autoscale"
